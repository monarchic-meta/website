      }
    },
    {
      "type": "RichTextNode",
      "key": "prose-neutral-lower",
      "parent": "neutral-prose-and-small-symbols",
      "attrs": {
        "name": "prose neutral lower",
        "position": "absolute",
        "left": "912px",
        "top": "663px",
        "width": "294px",
        "height": "auto",
        "text": "Its long measure turns into a\ncompact reading rhythm, held\nby thin rules and a geometric\nstar. The original French prose\nis deliberately not reproduced.\nThis is an editable study of\ncontour density, proportion,\ncontrast and divided space.\nThe lower panel continues the\nquiet typographic rhythm with\na deliberately small measure.\nEvery rule remains selectable.\nThe source stays visible in credit.",
        "fontName": "Inter",
        "fontSize": "14px",
        "lineHeight": "21px",
        "textColor": "#d3d6cd",
        "paragraphSpacing": 0
      }
