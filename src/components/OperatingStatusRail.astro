---
import { explicitMemBenchmark } from "../lib/explicitmemBenchmark";

interface Props {
  currentResearch?: string;
}

const { currentResearch } = Astro.props;
---

<div class="operating-status-rail border-b border-white/20" data-operating-status-rail>
  {currentResearch ? (
    <a
      href="/research"
      class="group grid min-h-11 grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 px-4 py-2 font-mono text-[0.58rem] font-bold uppercase transition hover:bg-white/[0.035] sm:grid-cols-[auto_1fr_auto] sm:px-6 lg:px-8"
      data-operating-status-variant="research-context"
    >
      <span class="col-start-1 row-start-1 inline-flex items-center gap-2 text-signal sm:col-auto sm:row-auto">
        <span class="operating-status-mark" aria-hidden="true"></span>
        Research / Published
      </span>
      <span class="col-span-2 row-start-2 text-white/68 sm:col-span-1 sm:row-auto">
        {currentResearch} / Evaluation report
      </span>
      <span class="research-rail-action col-start-2 row-start-1 inline-flex items-center gap-1.5 whitespace-nowrap text-white/80 transition group-hover:text-signal group-focus-visible:text-signal sm:col-auto sm:row-auto">
        <span>All research</span>
        <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />
        </svg>
      </span>
    </a>
  ) : (
    <a
      href="/research/explicitmem"
      class="group grid min-h-11 grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 px-4 py-2 font-mono text-[0.58rem] font-bold uppercase transition hover:bg-white/[0.035] sm:grid-cols-[auto_1fr_auto] sm:px-6 lg:px-8"
      data-operating-status-variant="latest-research"
    >
      <span class="col-start-1 row-start-1 inline-flex items-center gap-2 text-signal sm:col-auto sm:row-auto">
        <span class="operating-status-mark" aria-hidden="true"></span>
        Latest research
      </span>
      <span class="col-span-2 row-start-2 text-white/68 sm:col-span-1 sm:row-auto">
        ExplicitMem / {explicitMemBenchmark.answerAccuracy} answer accuracy on {explicitMemBenchmark.benchmark} ({explicitMemBenchmark.passedQuestions}/{explicitMemBenchmark.questions})
      </span>
      <span class="research-rail-action col-start-2 row-start-1 inline-flex items-center gap-1.5 whitespace-nowrap text-white/80 transition group-hover:text-signal group-focus-visible:text-signal sm:col-auto sm:row-auto">
        <span>Read report</span>
        <svg class="h-3 w-3 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 12 12 4M4 4h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" />
        </svg>
      </span>
    </a>
  )}
</div>
