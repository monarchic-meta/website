---
import OperatingStatusRail from "./OperatingStatusRail.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  active?: "products" | "research" | "support";
  researchBrief?: string;
  researchStatus?: string;
  researchTitle?: string;
}

const { active, researchBrief, researchStatus, researchTitle } = Astro.props;
---

<div
  data-research-brief={researchBrief}
  data-research-status={researchStatus}
  class="site-frame mx-auto flex min-h-screen max-w-[1480px] flex-col border-x border-white/20 bg-ink text-white"
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <SiteHeader active={active} />
  <OperatingStatusRail currentResearch={researchTitle} />
  <main id="main-content" tabindex="-1" class="flex-1">
    <slot />
  </main>
  <SiteFooter />
  <a href="#navigation" class="back-to-top" aria-label="Back to top" hidden>Top <span aria-hidden="true">↑</span></a>
</div>

<script>
  const backToTop = document.querySelector<HTMLAnchorElement>(".back-to-top");
  if (backToTop) {
    const update = () => { backToTop.hidden = window.scrollY < 640; };
    window.addEventListener("scroll", update, { passive: true });
    backToTop.addEventListener("click", (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
      document.querySelector<HTMLAnchorElement>(".site-wordmark")?.focus({ preventScroll: true });
    });
    update();
  }
</script>
