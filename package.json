{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:legibility": "node scripts/check-legibility.mjs",
    "check:catalog-artifact": "node scripts/check-catalog-artifact.mjs",
    "check:mcp-pricing": "node scripts/sync-mcp-pricing.mjs --check",
    "check:public-usage-language": "node scripts/check-public-usage-language.mjs",
    "check:shared-catalog": "node scripts/check-shared-catalog.mjs",
    "check:webcomposer": "node scripts/check-webcomposer-contract.mjs",
    "check:webinfo-artifacts": "node scripts/check-webinfo-artifacts.mjs",
    "check:webinfo-implementation": "node scripts/check-webinfo-implementation.mjs",
    "check:release-workflow": "node scripts/check-release-workflow.mjs",
    "check:social-preview": "node scripts/check-social-preview.mjs",
    "check:homepage-navigation": "node scripts/check-homepage-navigation.mjs",
    "vercel": "node scripts/vercel-cli.mjs",
    "vercel:whoami": "node scripts/vercel-cli.mjs whoami",
    "vercel:inspect:production": "node scripts/vercel-cli.mjs inspect https://www.monarchic.io",
    "deploy:vercel:local": "node scripts/deploy-vercel-local.mjs",
    "deploy:vercel:development": "MONARCHIC_VERCEL_PROJECT=development node scripts/deploy-vercel-local.mjs",
    "deploy:vercel:staging": "MONARCHIC_VERCEL_PROJECT=staging node scripts/deploy-vercel-local.mjs",
    "deploy:cloudflare:staging-proxy": "node scripts/deploy-cloudflare-staging-proxy.mjs",
    "sync:mcp-pricing": "node scripts/sync-mcp-pricing.mjs --write",
    "build": "node scripts/sync-mcp-pricing.mjs --check && astro build && node scripts/check-webinfo-implementation.mjs && node scripts/check-public-usage-language.mjs",
    "preview": "astro preview",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:local:static": "MONARCHIC_WEBSITE_SMOKE_STATIC_ONLY=true node scripts/smoke-local.mjs",
    "smoke:production": "MONARCHIC_WEBSITE_SMOKE_URL=https://www.monarchic.io MONARCHIC_WEBSITE_EXPECTED_CANONICAL_URL=https://monarchic.io node scripts/smoke-production.mjs",
    "smoke:production:www": "pnpm smoke:production",
    "smoke:production:apex": "node scripts/smoke-production.mjs",
    "smoke:development": "MONARCHIC_WEBSITE_SMOKE_URL=https://website-dev-monarchic.vercel.app MONARCHIC_WEBSITE_EXPECTED_CANONICAL_URL=https://website-dev-monarchic.vercel.app MONARCHIC_WEBSITE_EXPECTED_APP_URL=https://staging-app.monarchic.io node scripts/smoke-production.mjs",
    "smoke:staging": "MONARCHIC_WEBSITE_SMOKE_URL=https://staging.monarchic.io MONARCHIC_WEBSITE_EXPECTED_CANONICAL_URL=https://staging.monarchic.io MONARCHIC_WEBSITE_EXPECTED_APP_URL=https://staging-app.monarchic.io node scripts/smoke-production.mjs",
    "astro": "astro",
    "check:framer-studies": "node scripts/check-framer-study-resources.mjs",
    "check:website-brain": "node scripts/check-website-brain-port.mjs",
    "check:website-brain-dither": "node scripts/check-website-brain-dither.mjs",
    "check:website-brain-text": "node scripts/check-website-brain-text.mjs",
    "check:website-brain-fibers": "node scripts/check-website-brain-fibers.mjs",
    "check:website-brain-load": "node scripts/check-website-brain-load.mjs",
    "build:framer-brain-surface": "node scripts/build-framer-brain-surface.mjs --write",
    "check:solid-brain-study": "node scripts/check-solid-brain-study.mjs",
    "check:hero-recreation-study": "node scripts/check-hero-recreation-study.mjs",
    "check:hero-study-integration": "node scripts/check-hero-study-integration.mjs",
    "check:hero-recreation-browser": "node scripts/check-hero-recreation-browser.mjs",
    "build:framer-hero-head": "node scripts/build-framer-hero-head.mjs --write",
    "check:hero-mechanism-study": "node scripts/check-hero-mechanism-study.mjs",
    "check:hero-mechanism-integration": "node scripts/check-hero-mechanism-integration.mjs",
    "check:hero-mechanism-browser": "node scripts/check-hero-mechanism-browser.mjs",
    "build:framer-hero-mechanisms": "node scripts/build-framer-hero-mechanisms.mjs",
    "check:original-hero-study": "node scripts/check-original-hero-study.mjs",
    "check:original-hero-integration": "node scripts/check-original-hero-integration.mjs",
    "check:original-hero-browser": "node scripts/check-original-hero-browser.mjs",
    "check:source-hero-page-study": "node scripts/check-source-hero-page-study.mjs",
    "check:source-hero-page-browser": "node scripts/check-source-hero-page-browser.mjs",
    "check:type-face-sequence": "node scripts/check-type-face-sequence.mjs",
    "check:original-hero-round-two-study": "node scripts/check-original-hero-round-two-study.mjs",
    "check:original-hero-round-two-browser": "node scripts/check-original-hero-round-two-browser.mjs",
    "check:original-hero-round-two-integration": "node scripts/check-original-hero-round-two-integration.mjs",
    "build:original-hero-round-two": "node scripts/build-original-hero-round-two.mjs",
    "check:source-hero-journey-study": "node scripts/check-source-hero-journey-study.mjs",
    "check:source-hero-journey-browser": "node scripts/check-source-hero-journey-browser.mjs",
    "check:mecha-scroll-mark": "node scripts/check-mecha-scroll-mark.mjs",
    "check:mecha-scroll-mark-browser": "node scripts/check-mecha-scroll-mark-browser.mjs",
    "check:source-kaspar-ascii-study": "node scripts/check-source-kaspar-ascii-study.mjs",
    "check:source-kaspar-ascii-browser": "node scripts/check-source-kaspar-ascii-browser.mjs",
    "check:source-hero-native-behaviors": "node scripts/check-source-hero-native-behaviors.mjs",
    "check:source-bleibt-mark": "node scripts/check-source-bleibt-mark.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^8.0.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "svelte": "^5.53.12",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.59.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
