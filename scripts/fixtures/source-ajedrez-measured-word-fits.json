  "inversePatches": [
    {
      "name": "private measured table/helpers only",
      "after": "// Two existing independent-word actors have reviewed source-glyph geometry\n// across these five recorded frames. These literal fits retain the1172 anchors;\n// they do not identify poem tokens, infer easing or move the other82 actors.\n// Each row is [actor60 left,top,width, actor25 left,top,width], logical480px.\nconst AJEDREZ_TYPE_MEASURED_FITS: readonly (readonly [number, number, number, number, number, number])[] = [\n    [284, 480.5, 17, 320, 289.5, 31],\n    [188, 216.5, 16, 151, 216.5, 31],\n    [188, 216.5, 17, 151, 216.5, 31],\n    [188, 215.5, 16, 152, 215.5, 30],\n    [188, 215.5, 17, 151, 215.5, 31],\n]\n// One effect-dependency slot stays stable per host, but changes when either\n// the native host or this module changes. Weak keys do not retain native DOM.\nconst AJEDREZ_TYPE_MEASURED_OWNERS = new WeakMap<HTMLElement, object>()\nfunction ajedrezTypeMeasuredOwner(host: HTMLElement | null) {\n    if (!host) return null\n    let token = AJEDREZ_TYPE_MEASURED_OWNERS.get(host)\n    if (!token) { token = {}; AJEDREZ_TYPE_MEASURED_OWNERS.set(host, token) }\n    return token\n}\nfunction ajedrezTypeMeasuredFrame(time: number) {\n    const frame = Math.floor(Math.max(0, time) * 24 + 1e-7)\n    return frame >= 1169 && frame < 1174 ? frame : -1\n}\nfunction ajedrezTypeMeasuredFit(frame: number, index: number) {\n    if (index !== 60 && index !== 25) return null\n    const row = AJEDREZ_TYPE_MEASURED_FITS[frame - 1169], offset = index === 60 ? 0 : 3\n    return row ? { left: row[offset], top: row[offset + 1], width: row[offset + 2] } : null\n}\n",
      "before": ""
    },
    {
      "name": "let disposed = false, dirty = true, previousSample",
      "after": "            let disposed = false, dirty = true, previousSample = -1, previousMeasuredFrame = -1, previousWidth = -1, previousInset: boolean | null = null",
      "before": "            let disposed = false, dirty = true, previousSample = -1, previousWidth = -1, previousInset: boolean | null = null"
    },
    {
      "name": "if (!live) { clear(); dirty = true; previousSample",
      "after": "                if (!live) { clear(); dirty = true; previousSample = -1; previousMeasuredFrame = -1; previousInset = null; host.setAttribute(\"data-source-ajedrez-inset-score\", \"native-poster\"); host.setAttribute(\"data-source-ajedrez-grid-status\", \"native-poster\"); host.setAttribute(\"data-source-ajedrez-grid-count\", \"0\"); return }",
      "before": "                if (!live) { clear(); dirty = true; previousSample = -1; previousInset = null; host.setAttribute(\"data-source-ajedrez-inset-score\", \"native-poster\"); host.setAttribute(\"data-source-ajedrez-grid-status\", \"native-poster\"); host.setAttribute(\"data-source-ajedrez-grid-count\", \"0\"); return }"
    },
    {
      "name": "const sample = ajedrezTypeSample(current.time)",
      "after": "                const sample = ajedrezTypeSample(current.time), measuredFrame = ajedrezTypeMeasuredFrame(current.time), unit = host.offsetWidth > 0 ? host.offsetWidth / 480 : 1, screenUnit = host.offsetWidth > 0 ? host.getBoundingClientRect().width / host.offsetWidth : 1",
      "before": "                const sample = ajedrezTypeSample(current.time), unit = host.offsetWidth > 0 ? host.offsetWidth / 480 : 1, screenUnit = host.offsetWidth > 0 ? host.getBoundingClientRect().width / host.offsetWidth : 1"
    },
    {
      "name": "cache includes finite measured frame",
      "after": "                const measuredChanged = previousMeasuredFrame !== measuredFrame\n                if (!positionsChanged && !measuredChanged && previousInset === insetVisible) return\n                dirty = false; previousSample = sample.sourceFrame; previousMeasuredFrame = measuredFrame; previousWidth = host.offsetWidth; previousInset = insetVisible",
      "before": "                if (!positionsChanged && previousInset === insetVisible) return\n                dirty = false; previousSample = sample.sourceFrame; previousWidth = host.offsetWidth; previousInset = insetVisible"
    },
    {
      "name": "only changed measured actors gain individual writes",
      "after": "                    const measured = ajedrezTypeMeasuredFit(measuredFrame, index)\n                    if (positionsChanged || measuredChanged && measured !== null) write(node, Math.round((measured?.left ?? sample.xy[index * 2]) * unit * 100) / 100, Math.round((measured?.top ?? sample.xy[index * 2 + 1]) * unit * 100) / 100, sample.sourceFrame === 1176 ? null : (measured?.width ?? sample.widths[index]) * unit, screenUnit)",
      "before": "                    if (positionsChanged) write(node, Math.round(sample.xy[index * 2] * unit * 100) / 100, Math.round(sample.xy[index * 2 + 1] * unit * 100) / 100, sample.sourceFrame === 1176 ? null : sample.widths[index] * unit, screenUnit)"
    },
